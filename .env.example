# LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o

# Database (local: sqlite file — no Postgres install needed)
DATABASE_URL=sqlite:///./dev.db
# Docker Compose Postgres:
# DATABASE_URL=postgresql://school_ai:school_ai@db:5432/school_ai

# WhatsApp Business API
WHATSAPP_TOKEN=changeme
WHATSAPP_PHONE_NUMBER_ID=changeme
WHATSAPP_VERIFY_TOKEN=changeme

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# App
ENV=development
DEFAULT_TENANT_ID=demo-school
DEFAULT_TEACHER_ID=t1
TEACHER_EXCEL_PATH=data/teacher_workspace.xlsx
