# LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
INTENT_CONFIDENCE_THRESHOLD=0.6

# Demo data: every read and write goes to this workbook
SCHOOL_DATA_PATH=data/school_data.xlsx

# WhatsApp Business API
WHATSAPP_TOKEN=changeme
WHATSAPP_PHONE_NUMBER_ID=changeme
WHATSAPP_VERIFY_TOKEN=changeme

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# App
ENV=development
# Leave blank to use the first school / first teacher in the workbook
DEFAULT_TENANT_ID=
DEFAULT_TEACHER_ID=

# Voice (disabled unless explicitly enabled)
VOICE_ENABLED=false
WHISPER_MODEL=tiny
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
# STT concurrency: max active transcriptions (CPU default 1).
# VOICE_MAX_CONCURRENCY is a legacy alias used only when VOICE_MAX_PARALLEL is unset.
VOICE_MAX_PARALLEL=1
VOICE_MAX_CONCURRENCY=1
# Waiting jobs only (not counting active transcriptions). Reject with a busy reply when full.
VOICE_QUEUE_MAX=16
# After admission, if waiting jobs >= this, send one localized "processing" status.
VOICE_QUEUE_NOTIFY_AT=2
VOICE_MAX_SECONDS=30
VOICE_MAX_BYTES=5242880
TTS_CACHE_SIZE=128
# Legacy; overload is now controlled by VOICE_QUEUE_MAX (kept for older .env files).
VOICE_QUEUE_TIMEOUT=2.0
# Request limits per 60 seconds: per guardian, all voice requests, and /speak owner
VOICE_GUARDIAN_RATE=10
VOICE_GLOBAL_RATE=60
VOICE_SPEAK_RATE=20
VOICE_TTS_TIMEOUT=4.0
VOICE_VAD_SILENCE_MS=800
VOICE_IDLE_PROMPT_SECONDS=20
# Generated chat audio stays in process memory until one download or this many seconds
VOICE_AUDIO_TTL=300.0
